{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanjing",
  "version": "0.1.0",
  "identifier": "io.oceanflux.lanjing",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["legado", "yuedu", "lanjing"]
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lanjing",
        "width": 1440,
        "height": 960,
        "minWidth": 768,
        "minHeight": 720,
        "resizable": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; base-uri 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
