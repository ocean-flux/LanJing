{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "endOfLine": "lf",
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./src/index.css",
    "functions": [
      "cn",
      "clsx",
      "tv",
      "cva"
    ]
  },
  "svelte": {},
  "ignorePatterns": [
    "src-tauri/",
    "src/shared/paraglide/"
  ]
}
