{
  "name": "lanjing",
  "version": "0.1.0",
  "private": true,
  "description": "LanJing - cross-platform media discovery and reading workbench",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:web": "vitest run",
    "lint:web": "oxlint src vite.config.js --ignore-path .gitignore --deny-warnings",
    "lint:fix:web": "oxlint src vite.config.js --fix --ignore-path .gitignore --deny-warnings",
    "typecheck:web": "tsc --noEmit",
    "format:web": "oxfmt src package.json vite.config.js tsconfig.json index.html components.json --write",
    "format:check:web": "oxfmt src package.json vite.config.js tsconfig.json index.html components.json --check",
    "lint": "pnpm run lint:web",
    "format": "pnpm run format:web",
    "format:check": "pnpm run format:check:web",
    "check": "pnpm run lint:web && pnpm run typecheck:web && pnpm run format:check:web && pnpm run test:web"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@inlang/paraglide-js": "^2.23.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@xyflow/react": "^12.11.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "elkjs": "0.12.0",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@iconify-json/ph": "^1.2.2",
    "@iconify/tailwind4": "^1.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "lefthook": "^2.1.10",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.11.0"
}
