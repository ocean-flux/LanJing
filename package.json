{
  "name": "lanjing",
  "version": "0.1.0",
  "private": true,
  "description": "LanJing - cross-platform media discovery and reading workbench",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:web": "vitest run",
    "lint:web": "oxlint src vite.config.js --ignore-path .gitignore --deny-warnings",
    "lint:fix:web": "oxlint src vite.config.js --fix --ignore-path .gitignore --deny-warnings",
    "typecheck:web": "tsc --noEmit",
    "format:web": "oxfmt src package.json vite.config.js tsconfig.json index.html components.json --write",
    "format:check:web": "oxfmt src package.json vite.config.js tsconfig.json index.html components.json --check",
    "static:web": "pnpm run lint:web && pnpm run typecheck:web && pnpm run format:check:web",
    "lint": "pnpm run lint:web",
    "format": "pnpm run format:web",
    "format:check": "pnpm run format:check:web",
    "check": "pnpm run static:web && pnpm run test:web",
    "verify": "pnpm run check && cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets --all-features -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml --workspace"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@codemirror/autocomplete": "catalog:",
    "@codemirror/commands": "catalog:",
    "@codemirror/lang-javascript": "catalog:",
    "@codemirror/language": "catalog:",
    "@codemirror/lint": "catalog:",
    "@codemirror/search": "catalog:",
    "@codemirror/state": "catalog:",
    "@codemirror/view": "catalog:",
    "@inlang/paraglide-js": "catalog:",
    "@tauri-apps/api": "catalog:",
    "@tauri-apps/plugin-deep-link": "catalog:",
    "@tauri-apps/plugin-opener": "catalog:",
    "@tauri-apps/plugin-os": "catalog:",
    "@tauri-store/zustand": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@xyflow/react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "codemirror": "catalog:",
    "elkjs": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "catalog:",
    "react-router-dom": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@iconify-json/ph": "catalog:",
    "@iconify/tailwind4": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tailwindcss": "catalog:",
    "shadcn": "catalog:",
    "tailwindcss": "catalog:",
